{
  "name": "@devspec/pi-plugin",
  "version": "0.1.0",
  "description": "DevSpec for Pi — native tools, auth, remote control, and memory for the Pi coding agent. One install, everything included.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "devspec",
    "coding-agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DevSpecAI/DevSpec-Pi.git"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ],
    "themes": [
      "./themes"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "generate:catalog": "node scripts/generate-mcp-catalog.mjs",
    "test": "node --test tests/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.84.1",
    "@earendil-works/pi-coding-agent": "^0.84.1",
    "@earendil-works/pi-tui": "^0.84.1",
    "@types/node": "^22.0.0",
    "typebox": "^1.3.12",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
